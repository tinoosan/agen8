# The embedded SPA bundle is generated by `make build` (vite) and committed so
# the Go binary can //go:embed it and CI can compile without Node. It is not
# hand-edited. Marking it generated keeps the hashed-asset churn out of code
# review: GitHub collapses these files in PR diffs and excludes them from
# language stats, and `-diff` stops git from computing a textual diff locally.
internal/web/dist/** linguist-generated=true
internal/web/dist/** -diff

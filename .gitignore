# Generated web assets. The embedded SPA bundle is built by `make build` /
# `npm run build` (vite) and is NOT committed — only the .gitkeep placeholder is
# tracked, so `//go:embed all:dist` compiles offline (fresh checkout, Node-free
# Go CI). The build recreates .gitkeep after vite empties the directory.
internal/web/dist/*
!internal/web/dist/.gitkeep
web/test-results/


playground/.agen8/
playground/.agen8/**
playground/playwright-cli/
playground/workspace/
playground/workspace/**



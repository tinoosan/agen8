{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "daemon",
      "runtimeExecutable": "make",
      "runtimeArgs": ["dev", "remote"],
      "port": 7777,
      "env": {
        "NODE_OPTIONS": "--max-http-header-size=65536"
      }
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev", "--", "--port", "5290", "--strictPort"],
      "port": 5290
    },
    {
      "name": "web-livecheck",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "web", "run", "dev", "--", "--port", "5291", "--strictPort"],
      "port": 5291,
      "env": {
        "AGEN8_WEB_PROXY_TARGET": "http://127.0.0.1:7878"
      }
    },
    {
      "name": "mockup",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4599", "--directory", "/tmp/agen8-cred-mockup"],
      "port": 4599
    }
  ]
}
